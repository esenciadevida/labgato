APP_NAME="Labgoto"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Set when behind a TLS-terminating reverse proxy (e.g. nginx). Required for
# HTTPS redirect + HSTS headers. Defaults to '*' (trust all) when unset.
# TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=labgoto
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Send cookies over HTTPS only. Set to true in production.
SESSION_SECURE_COOKIE=false

# Log admin sessions out after this many minutes of inactivity.
ADMIN_INACTIVITY_MINUTES=30

# Require a one-time sign-in code (emailed) for admin logins.
ADMIN_TWO_FACTOR=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notifications@labgoto.local
MAIL_FROM_NAME="Labgoto"

AI_ENABLED=false
AI_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=15
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
AI_COOLDOWN_SECONDS=5
AI_DAILY_USER_LIMIT=50
AI_DAILY_GLOBAL_LIMIT=1000

FEATURE_AI=false

FEATURE_SEARCH=true
SEARCH_PER_PAGE=10
SEARCH_RATE_LIMIT_PER_MINUTE=30
SEARCH_QUERY_LOGGING=true
SEARCH_QUERY_LOG_IP=false
SEARCH_MAX_QUERY_LENGTH=255

# Absolute URL of the default Open Graph image (optional).
DEFAULT_OG_IMAGE=

LABGOTO_SEED_ADMIN=false
LABGOTO_ADMIN_EMAIL=
LABGOTO_ADMIN_PASSWORD=

# Optional password to encrypt backup archives.
BACKUP_ARCHIVE_PASSWORD=
# Email that receives backup failure notifications (optional).
BACKUP_NOTIFICATION_EMAIL=

# Email that receives error alerts, queue health alerts and the weekly digest.
# Comma-separated list allowed; when empty, digs fall back to active admins.
ERROR_NOTIFICATION_EMAIL=
# Seconds to suppress repeat alerts for the same error (default 900).
ERROR_ALERT_COOLDOWN_SECONDS=900
# Retention (days) for audit logs pruned by audit-logs:prune (default 365).
AUDIT_RETENTION_DAYS=365
# Queue health watchdog window (hours) and alert threshold (defaults 24 / 10).
QUEUE_HEALTH_WINDOW_HOURS=24
QUEUE_HEALTH_FAILED_THRESHOLD=10
# Days summarized by the weekly digest (default 7).
DIGEST_WEEK_DAYS=7

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
